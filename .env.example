# Copy to .env and edit. Defaults are production-safe: API keys required, model registry enforced.
TRIAGE_ENV=production                    # production | staging | local | test
# Generate a key:  python -c "import secrets;print(secrets.token_urlsafe(32))"  then hash it:
#   python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <key>
# Format: name:role:sha256hex;name:role:sha256hex   (roles: operator, auditor, admin)
TRIAGE_API_KEYS=
TRIAGE_CORS_ORIGINS=                     # comma-separated explicit origins; '*' is rejected
TRIAGE_RATE_LIMIT_PER_MINUTE=120
TRIAGE_DB_PATH=calls.db
TRIAGE_REGISTRY_PATH=models/registry.json
TRIAGE_ALLOW_V1_FALLBACK=false           # true => degraded v1 results are labelled, never silent
TRIAGE_AUDIT_RETENTION_DAYS=
TRIAGE_LOG_LEVEL=INFO
# Local development only (rejected in production/staging):
# TRIAGE_ENV=local
# TRIAGE_AUTH_MODE=disabled
# TRIAGE_REGISTRY_ENFORCE=false
